<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ equivalent of backup_rules.xml (device-to-device transfer + cloud backup). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="distraction_alert_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="distraction_alert_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
